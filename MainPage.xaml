<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToDo2.MainPage"
             BackgroundColor="#F1F4F9">

    <Grid Padding="25"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="22">

        <!-- CABEÇALHO -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="5">

            <Label Text="Minhas tarefas"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#172B4D"/>

            <Label Text="Organize seu dia, uma tarefa por vez."
                   FontSize="14"
                   TextColor="#64748B"/>

        </VerticalStackLayout>

        <!-- ÁREA DE ADICIONAR TAREFA -->
        <VerticalStackLayout Grid.Row="1"
                             Spacing="12">

            <Label Text="Nova tarefa"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="#334155"/>

            <Border BackgroundColor="White"
                    Stroke="#DCE3ED"
                    StrokeThickness="1"
                    Padding="12"
                    StrokeShape="RoundRectangle 12">

                <Entry x:Name="taskEntry"
                       Placeholder="Digite sua tarefa..."
                       PlaceholderColor="#94A3B8"
                       TextColor="#172B4D"
                       BackgroundColor="Transparent"
                       ClearButtonVisibility="WhileEditing"/>
                <Picker x:Name="categoryPicker" Title="Selecione a categoria">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Trabalho</x:String>
                            <x:String>Trabalho</x:String>
                            <x:String>Pesoal</x:String>
                        </x:Array>
                        
                    </Picker.ItemsSource>
                </Picker>
                <DatePicker x:Name="dueDatePicker" />

            </Border>

            <Button Text="＋  Adicionar tarefa"
                    Clicked="OnAddTaskClicked"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="52"/>

        </VerticalStackLayout>

        <!-- TÍTULO DA LISTA -->
        <Label Grid.Row="2"
               Text="Sua lista"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="#172B4D"/>

        <!-- LISTA DE TAREFAS -->
        <ListView x:Name="taskListView"
                  Grid.Row="3"
                  HasUnevenRows="True"
                  SeparatorVisibility="None"
                  BackgroundColor="Transparent"
                  SelectionMode="None">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>

                        <Border BackgroundColor="White"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Margin="0,5"
                                Padding="12">

                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="8">

                                <Label Grid.Column="0"
                                       Text="{Binding TaskName}"
                                       TextColor="#172B4D"
                                       FontSize="15"
                                       VerticalOptions="Center"
                                       LineBreakMode="WordWrap"/>

                                <Button Grid.Column="1"
                                        Text="Concluir"
                                        Clicked="OnCompleteTaskCliked"
                                        BackgroundColor="#DCFCE7"
                                        TextColor="#15803D"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        CornerRadius="9"
                                        Padding="10,8"/>

                                <Button Grid.Column="2"
                                        Text="Excluir"
                                        Clicked="OnDeleteTaskClicked"
                                        BackgroundColor="#FEE2E2"
                                        TextColor="#DC2626"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        CornerRadius="9"
                                        Padding="10,8"/>

                            </Grid>

                        </Border>

                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

    </Grid>

</ContentPage>
